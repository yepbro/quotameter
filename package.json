{
  "name": "quotameter",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted web service that monitors usage quotas for AI subscriptions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:component": "vitest run test/component",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  }
}
