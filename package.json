{
  "name": "quotameter",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted web service that monitors usage quotas for AI subscriptions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "vue-tsc --noEmit -p ui/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:ui",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "license:check": "node scripts/check-licenses.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:ui": "vite build ui",
    "preview:ui": "vite preview ui --port 4173 --strictPort --host 127.0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vue": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
