{
  "name": "quotameter",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted web service that monitors usage quotas for AI subscriptions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:e2e": "playwright test",
    "build:ui": "vite build ui",
    "preview:ui": "vite preview ui --port 4173 --strictPort --host 127.0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
