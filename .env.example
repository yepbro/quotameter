# Quotameter development environment example.
#
# Copy to `.env` and adjust if needed. `.env` is git-ignored; never put real
# API keys or passwords in it. The variables below point Compose-side paths;
# they are the only supported environment overrides at this stage.

# Configuration directory used inside the development container.
# Default: /var/lib/quotameter/config (isolated Docker volume).
QUOTAMETER_CONFIG_DIR=/var/lib/quotameter/config

# Data directory (SQLite databases, logs) used inside the development
# container. Default: /var/lib/quotameter/data (isolated Docker volume).
QUOTAMETER_DATA_DIR=/var/lib/quotameter/data
